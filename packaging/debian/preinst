#!/bin/sh
# Remove uma instalação manual anterior (instalar.sh em /usr/local), que teria prioridade no PATH e no systemd.
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  if [ -e /usr/local/bin/avell-fan ] || [ -e /etc/systemd/system/avell-fan.service ]; then
    echo "avell-fan: removendo a instalação manual anterior (instalar.sh)"
    systemctl disable --now avell-fan >/dev/null 2>&1 || true
    rm -f /etc/systemd/system/avell-fan.service /usr/local/bin/avell-fan /usr/local/bin/avell-fan-gui \
          /etc/modules-load.d/avell-fan.conf /usr/local/share/applications/avell-fan.desktop \
          /usr/local/share/icons/hicolor/scalable/apps/avell-fan.svg
    rm -rf /usr/local/share/avell-fan
    # o autostart manual tem o mesmo caminho do pacote: apaga para o dpkg não perguntar
    rm -f /etc/xdg/autostart/avell-fan-tray.desktop
    systemctl daemon-reload || true
  fi
  # versões antigas dos drivers no DKMS (manual ou pacote anterior)
  for v in $(dkms status -m avell-fan-drivers 2>/dev/null | sed -n 's#^avell-fan-drivers/\([^,:]*\).*#\1#p' | sort -u); do
    if [ "$v" != "@VER@" ]; then
      dkms remove -m avell-fan-drivers -v "$v" --all >/dev/null 2>&1 || true
      rm -rf "/usr/src/avell-fan-drivers-$v"
    fi
  done
fi
exit 0
