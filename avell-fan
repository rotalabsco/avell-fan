#!/usr/bin/env python3
"""avell-fan: controle de fans para o Avell C62 LIV (chassi Uniwill) via /dev/tuxedo_io.

Comandos:
  avell-fan status              mostra temperaturas, velocidades e perfil (não precisa de root com o daemon rodando)
  avell-fan perfil <nome>       troca o perfil (auto, silencioso, equilibrado, maximo)
  avell-fan proximo             alterna para o próximo perfil
  avell-fan daemon              loop de controle (root; normalmente via systemd)
  avell-fan auto                devolve os fans para o controle automático da BIOS (root)
  avell-fan testar <pct> [seg]  força os dois fans em <pct>% por alguns segundos e volta pro auto (root)
  avell-fan carga [modo]        mostra ou define o limite de carga da bateria (definir: root)
                                high_capacity (~100%), balanced (~90%), stationary (~80%)
  avell-fan teclado [brilho] [#cor]  mostra ou muda o brilho (0-4) e a cor do teclado (via serviço)
  avell-fan versao              mostra a versão
  avell-fan led-teste           passa a luz do botão de modo por economia/normal/turbo e restaura (root)
  avell-fan botao               mostra as teclas recebidas pelo "TUXEDO Keyboard" (root) para achar o botão de fan
"""
import array
import fcntl
import glob
import json
import os
import select
import signal
import struct
import subprocess
import sys
import threading
import time

# ---------------------------------------------------------------- ioctl (conferido contra tuxedo_io_ioctl.h)
VERSION = "1.1"
DEV = "/dev/tuxedo_io"
_R, _W = 0xEC + 3, 0xEC + 4
def _ior(nr): return (2 << 30) | (8 << 16) | (_R << 8) | nr
def _iow(nr): return (1 << 30) | (8 << 16) | (_W << 8) | nr
R_FANSPEED, R_FANSPEED2, R_FAN_TEMP, R_FAN_TEMP2 = _ior(0x10), _ior(0x11), _ior(0x12), _ior(0x13)
R_MODE = _ior(0x14)  # EC 0x0751; bit 0x40 = "full fan mode"
W_FANSPEED, W_FANSPEED2 = _iow(0x10), _iow(0x11)
W_FANAUTO = (_W << 8) | 0x14
W_PERF_PROF = _iow(0x18)  # bits 0xa0/0x10 do EC 0x0751: modo de energia, que acende a luz do botão de modo
# modo de energia do EC (uw_perf_profiles_v1) -> bits em 0x0751
MODOS_ENERGIA = {1: ("economia", 0xA0), 2: ("normal", 0x00), 3: ("turbo", 0x10)}
# luz no Avell C62 LIV: economia apagada, normal fraca, turbo forte. Automático = turbo: a BIOS
# cuida dos fans com o notebook liberado, como o modo padrão do Control Center no Windows.
MODO_DO_PERFIL = {"silencioso": 1, "equilibrado": 2, "maximo": 3, "auto": 3}
RAW_MAX = 200  # escala do EC: 0..200 = 0..100%

# ---------------------------------------------------------------- configuração
RUN_DIR = "/run/avell-fan"
PERFIL_FILE = f"{RUN_DIR}/perfil"
STATUS_FILE = f"{RUN_DIR}/status.json"
PERSIST_FILE = "/var/lib/avell-fan/perfil"
CONFIG_FILE = "/etc/avell-fan.json"
CARGA_DIR = "/sys/devices/platform/tuxedo_keyboard/charging_profile"
POWER_DIR = "/sys/class/power_supply"
LED_DIR = "/sys/class/leds/rgb:kbd_backlight"
FN_LOCK_FILE = "/sys/devices/platform/tuxedo_keyboard/fn_lock"
TECLADO_PEDIDO = f"{RUN_DIR}/teclado"             # usuário escreve (0666), o serviço aplica
TECLADO_SALVO = "/var/lib/avell-fan/teclado.json"  # reaplicado a cada boot
# perfis de carga do EC Uniwill (tuxedo_keyboard): limite aproximado da bateria
CARGAS = {"high_capacity": 100, "balanced": 90, "stationary": 80}

DEFAULT_CONFIG = {
    "perfil_padrao": "equilibrado",
    # ordem usada pelo botão / "proximo"
    "ciclo": ["silencioso", "equilibrado", "maximo", "auto"],
    # curvas: lista de [temperatura °C, % do fan]; interpolação linear entre os pontos
    "perfis": {
        # piso de 25%: abaixo disso o driver desliga o fan e ele fica liga/desliga
        "silencioso":  [[50, 25], [65, 30], [75, 45], [82, 65], [88, 100]],
        "equilibrado": [[45, 25], [60, 35], [70, 50], [80, 75], [87, 100]],
        "maximo":      [[0, 100]],
    },
    "intervalo_s": 2,
    "temp_failsafe": 90,          # acima disso: 100% independente do perfil
    "failsafe_saida_c": 5,        # só sai do failsafe quando cair X °C abaixo do limite
    "queda_max_pct_por_ciclo": 3, # desacelera devagar para não ficar oscilando
    "histerese_c": 3,             # só reduz se a temperatura cair X °C abaixo do ponto que subiu
    "pct_minimo": 25,             # nunca manda menos que isso no modo manual (fan parado = risco)
    "reaplicar_s": 30,            # regrava a velocidade periodicamente (EC pode resetar após suspend)
    # Tecla de modo ao lado do power (evento WMI 0xB0): o driver a converte em Meta+Alt+F6 no
    # dispositivo "TUXEDO Keyboard". Só esse dispositivo é lido, então um F6 comum não conta.
    "botao_keycode": 64,          # KEY_F6; null desliga. Para conferir: sudo avell-fan botao
    # luz do botão de modo acompanha o perfil (silencioso=economia, equilibrado=normal, maximo/auto=turbo).
    # Esses bits também são o "modo de energia" do EC: em alguns modelos mudam o limite de potência.
    "led_botao": False,
    "carga": None,                # limite da bateria: high_capacity (100%) | balanced (90%) | stationary (80%); None = não mexe
    "perfil_tomada": None,        # perfil aplicado ao ligar na tomada; None = não troca
    "perfil_bateria": None,       # perfil aplicado ao tirar da tomada; None = não troca
}


def validate_user_config(user):
    """Valida o JSON do usuário; levanta ValueError com mensagem em pt-BR."""
    if not isinstance(user, dict):
        raise ValueError("config deve ser um objeto JSON")
    perfis = user.get("perfis", {})
    if not isinstance(perfis, dict):
        raise ValueError("'perfis' deve ser um objeto")
    for nome, pts in perfis.items():
        if nome == "auto" or not nome.replace("_", "").isalnum():
            raise ValueError(f"nome de perfil inválido: {nome!r}")
        if not isinstance(pts, list) or not pts:
            raise ValueError(f"perfil {nome}: precisa de pelo menos 1 ponto")
        pts_ord = sorted(pts)
        for pt in pts_ord:
            if (not isinstance(pt, list) or len(pt) != 2
                    or not all(isinstance(v, (int, float)) for v in pt)
                    or not 0 <= pt[0] <= 105 or not 0 <= pt[1] <= 100):
                raise ValueError(f"perfil {nome}: ponto inválido {pt} (temp 0-105, % 0-100)")
        for (t0, p0), (t1, p1) in zip(pts_ord, pts_ord[1:]):
            if p1 < p0:
                raise ValueError(f"perfil {nome}: a % não pode diminuir quando a temperatura sobe ({t0}°C {p0}% > {t1}°C {p1}%)")
    tf = user.get("temp_failsafe", 90)
    if not isinstance(tf, (int, float)) or not 70 <= tf <= 95:
        raise ValueError("temp_failsafe deve ficar entre 70 e 95 °C")
    pm = user.get("pct_minimo", 25)
    if not isinstance(pm, (int, float)) or not 15 <= pm <= 100:
        raise ValueError("pct_minimo deve ficar entre 15 e 100")
    bk = user.get("botao_keycode", 64)
    if bk is not None and (not isinstance(bk, int) or not 1 <= bk <= 767):
        raise ValueError("botao_keycode deve ser um código de tecla (1-767) ou null")
    if not isinstance(user.get("led_botao", False), bool):
        raise ValueError("led_botao deve ser true ou false")
    carga = user.get("carga")
    if carga is not None and carga not in CARGAS:
        raise ValueError(f"carga deve ser {', '.join(CARGAS)} ou null")
    validos = {"auto"} | set(DEFAULT_CONFIG["perfis"]) | set(perfis)
    for k in ("perfil_tomada", "perfil_bateria"):
        v = user.get(k)
        if v is not None and v not in validos:
            raise ValueError(f"{k}: perfil desconhecido {v!r}")


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        with open(CONFIG_FILE) as f:
            user = json.load(f)
        validate_user_config(user)
        cfg.update({k: v for k, v in user.items() if k != "perfis"})
        cfg["perfis"].update(user.get("perfis", {}))
    except FileNotFoundError:
        pass
    except (ValueError, OSError) as e:
        print(f"config {CONFIG_FILE} ignorada: {e}", file=sys.stderr, flush=True)
    return cfg


def config_mtime():
    try:
        return os.stat(CONFIG_FILE).st_mtime
    except OSError:
        return None


# ---------------------------------------------------------------- hardware
class EC:
    def __init__(self):
        self.fd = os.open(DEV, os.O_RDWR)

    def _read(self, cmd):
        buf = array.array("i", [0])
        fcntl.ioctl(self.fd, cmd, buf, True)
        return buf[0]

    def _write(self, cmd, value):
        fcntl.ioctl(self.fd, cmd, array.array("i", [int(value)]), True)

    def mode(self):
        return self._read(R_MODE)

    def temps(self):
        return self._read(R_FAN_TEMP), self._read(R_FAN_TEMP2)

    def speeds_pct(self):
        return (round(self._read(R_FANSPEED) * 100 / RAW_MAX), round(self._read(R_FANSPEED2) * 100 / RAW_MAX))

    def set_pct(self, pct, minimo=0):
        pct = max(pct, minimo)
        raw = max(0, min(RAW_MAX, round(pct * RAW_MAX / 100)))
        self._write(W_FANSPEED, raw)
        self._write(W_FANSPEED2, raw)

    def auto(self):
        fcntl.ioctl(self.fd, W_FANAUTO)

    def modo_energia(self):
        """1 economia, 2 normal, 3 turbo (None se os bits não baterem com nenhum)."""
        bits = self.mode() & 0xB0
        return next((n for n, (_, b) in MODOS_ENERGIA.items() if b == bits), None)

    def set_modo_energia(self, n):
        self._write(W_PERF_PROF, n)  # o driver preserva os outros bits (inclusive 0x40 do fan)


def curve(points, temp):
    pts = sorted(points)
    if temp <= pts[0][0]:
        return pts[0][1]
    for (t0, p0), (t1, p1) in zip(pts, pts[1:]):
        if temp <= t1:
            if t1 == t0:
                return max(p0, p1)
            return p0 + (p1 - p0) * (temp - t0) / (t1 - t0)
    return pts[-1][1]


# ---------------------------------------------------------------- bateria e energia
def carga_atual():
    """Perfil de carga atual do EC, ou None se o driver não expõe."""
    try:
        with open(f"{CARGA_DIR}/charging_profile") as f:
            return f.read().strip()
    except OSError:
        return None


def aplicar_carga(cfg):
    alvo = cfg.get("carga")
    atual = carga_atual()
    if alvo is None or atual is None or alvo == atual:
        return
    try:
        with open(f"{CARGA_DIR}/charging_profile", "w") as f:
            f.write(alvo)
        print(f"carga da bateria: {atual} -> {alvo}", flush=True)
    except OSError as e:
        print(f"não consegui mudar a carga da bateria: {e}", file=sys.stderr, flush=True)


def _ps_ler(nome, campo):
    try:
        with open(f"{POWER_DIR}/{nome}/{campo}") as f:
            return f.read().strip()
    except OSError:
        return None


def energia():
    """(na_tomada, bateria_pct, estado_bateria); None onde não houver informação."""
    tomada = bat = estado = None
    try:
        nomes = sorted(os.listdir(POWER_DIR))
    except OSError:
        nomes = []
    for n in nomes:
        tipo = _ps_ler(n, "type")
        if tipo == "Mains" and tomada is None:
            on = _ps_ler(n, "online")
            tomada = None if on is None else on == "1"
        elif tipo == "Battery" and bat is None:
            cap = _ps_ler(n, "capacity")
            bat = int(cap) if cap and cap.isdigit() else None
            estado = _ps_ler(n, "status")
    return tomada, bat, estado


# ---------------------------------------------------------------- teclado (LED RGB e Fn lock)
def _ler(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def teclado_estado():
    """{"brilho", "max", "cor", "fn_lock"}; None nos campos que o driver não expõe."""
    b, mx, rgb, fl = (_ler(f"{LED_DIR}/brightness"), _ler(f"{LED_DIR}/max_brightness"),
                      _ler(f"{LED_DIR}/multi_intensity"), _ler(FN_LOCK_FILE))
    cor = None
    if rgb and len(rgb.split()) == 3:
        cor = "#" + "".join(f"{min(255, int(v)):02x}" for v in rgb.split())
    return {"brilho": int(b) if b and b.isdigit() else None, "max": int(mx) if mx and mx.isdigit() else None,
            "cor": cor, "fn_lock": None if fl is None else fl == "1"}


def validar_teclado(t):
    if not isinstance(t, dict):
        raise ValueError("pedido do teclado deve ser um objeto JSON")
    out = {}
    if "brilho" in t:
        if not isinstance(t["brilho"], int) or not 0 <= t["brilho"] <= 10:
            raise ValueError("brilho deve ser um inteiro de 0 a 10")
        out["brilho"] = t["brilho"]
    if "cor" in t:
        c = t["cor"]
        if not isinstance(c, str) or len(c) != 7 or c[0] != "#" or any(x not in "0123456789abcdefABCDEF" for x in c[1:]):
            raise ValueError("cor deve ser #rrggbb")
        out["cor"] = c.lower()
    if "fn_lock" in t:
        if not isinstance(t["fn_lock"], bool):
            raise ValueError("fn_lock deve ser true ou false")
        out["fn_lock"] = t["fn_lock"]
    return out


def aplicar_teclado(t):
    """Grava no sysfs (root). Ignora o que o driver não expõe."""
    def w(path, v):
        try:
            with open(path, "w") as f:
                f.write(v)
        except OSError as e:
            print(f"teclado: não consegui gravar {path}: {e}", file=sys.stderr, flush=True)
    if "cor" in t and os.path.exists(f"{LED_DIR}/multi_intensity"):
        c = t["cor"]
        w(f"{LED_DIR}/multi_intensity", f"{int(c[1:3], 16)} {int(c[3:5], 16)} {int(c[5:7], 16)}")
    if "brilho" in t and os.path.exists(f"{LED_DIR}/brightness"):
        mx = teclado_estado()["max"] or 4
        w(f"{LED_DIR}/brightness", str(min(t["brilho"], mx)))
    if "fn_lock" in t and os.path.exists(FN_LOCK_FILE):
        w(FN_LOCK_FILE, "1" if t["fn_lock"] else "0")


def processar_pedido_teclado():
    """Aplica /run/avell-fan/teclado (escrito pela interface) e guarda para o próximo boot."""
    try:
        with open(TECLADO_PEDIDO) as f:
            txt = f.read(4096).strip()  # arquivo aberto a todos: lê no máximo 4 KB
    except OSError:
        return
    if not txt:
        return
    try:
        t = validar_teclado(json.loads(txt))
    except ValueError as e:
        print(f"pedido do teclado ignorado: {e}", file=sys.stderr, flush=True)
        t = None
    with open(TECLADO_PEDIDO, "w"):
        pass  # esvazia: pedido consumido
    if not t:
        return
    aplicar_teclado(t)
    salvo = {}
    try:
        with open(TECLADO_SALVO) as f:
            salvo = validar_teclado(json.load(f))
    except (OSError, ValueError):
        pass
    salvo.update(t)
    try:
        os.makedirs(os.path.dirname(TECLADO_SALVO), exist_ok=True)
        with open(TECLADO_SALVO, "w") as f:
            json.dump(salvo, f)
    except OSError:
        pass


def restaurar_teclado():
    try:
        with open(TECLADO_SALVO) as f:
            aplicar_teclado(validar_teclado(json.load(f)))
    except (OSError, ValueError):
        pass


# ---------------------------------------------------------------- estado compartilhado
def read_perfil(cfg):
    for path in (PERFIL_FILE, PERSIST_FILE):
        try:
            with open(path) as f:
                p = f.read().strip()
            if p == "auto" or p in cfg["perfis"]:
                return p
        except (FileNotFoundError, PermissionError):
            pass
    return cfg["perfil_padrao"]


def write_perfil(nome):
    with open(PERFIL_FILE, "w") as f:
        f.write(nome + "\n")
    try:
        os.makedirs(os.path.dirname(PERSIST_FILE), exist_ok=True)
        with open(PERSIST_FILE, "w") as f:
            f.write(nome + "\n")
    except PermissionError:
        pass  # usuário comum: o daemon persiste no próximo ciclo


def sd_notify(msg):
    """Avisa o systemd (Type=notify / watchdog). Sem efeito fora do systemd."""
    import socket
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sk:
            sk.sendto(msg.encode(), addr)
    except OSError:
        pass


def notify(msg):
    """Notificação no desktop do usuário logado (melhor esforço)."""
    for bus in glob.glob("/run/user/*/bus"):
        uid = int(bus.split("/")[3])
        if uid == 0:
            continue
        try:
            subprocess.Popen(
                ["setpriv", f"--reuid={uid}", f"--regid={uid}", "--init-groups",
                 "notify-send", "-a", "Avell Fan", "-i", "avell-fan", "-t", "2000", "Avell Fan", msg],
                env={"DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}", "PATH": "/usr/bin:/bin"},
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


# ---------------------------------------------------------------- botão
def find_tuxedo_input():
    for name_file in glob.glob("/sys/class/input/event*/device/name"):
        with open(name_file) as f:
            if f.read().strip() == "TUXEDO Keyboard":
                return "/dev/input/" + name_file.split("/")[4]
    return None


EV_FMT = "llHHi"
EV_SIZE = struct.calcsize(EV_FMT)
EV_KEY = 1


def key_events(path):
    with open(path, "rb", buffering=0) as f:
        while True:
            r, _, _ = select.select([f], [], [], 5)
            if not r:
                continue
            data = f.read(EV_SIZE)
            if len(data) < EV_SIZE:
                continue
            _, _, typ, code, value = struct.unpack(EV_FMT, data)
            if typ == EV_KEY and value == 1:
                yield code


def next_perfil(cfg, atual):
    ciclo = cfg["ciclo"]
    return ciclo[(ciclo.index(atual) + 1) % len(ciclo)] if atual in ciclo else ciclo[0]


ULTIMO_BOTAO = [0.0]  # monotonic do último toque recebido como tecla


def _acordou_desde(ultimo):
    """True se o notebook suspendeu desde a última chamada (BOOTTIME avança, MONOTONIC não)."""
    d = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
    return d - ultimo[0] > 1, d


def led_thread(get_cfg, stop):
    """Luz do botão = modo de energia do EC (0x0751). Com led_botao ligado, o firmware passa a tratar
    o botão sozinho: troca o modo (e a luz) e não manda mais a tecla. Então uma mudança de modo que não
    foi feita pelo serviço é um toque no botão: avança o perfil e acerta o modo para o novo perfil."""
    try:
        ec = EC()
    except OSError:
        return
    esperado = None
    sono = [time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()]
    while not stop.is_set():
        stop.wait(0.3)
        cfg = get_cfg()
        if not cfg.get("led_botao"):
            esperado = None
            continue
        try:
            acordou, sono[0] = _acordou_desde(sono)
            perfil = read_perfil(cfg)
            atual = ec.modo_energia()
            if esperado is not None and atual != esperado and not acordou \
                    and time.monotonic() - ULTIMO_BOTAO[0] > 2:
                perfil = next_perfil(cfg, perfil)
                write_perfil(perfil)
                print(f"botão (modo do EC {esperado} -> {atual}): perfil {perfil}", flush=True)
                notify(f"Perfil: {perfil}")
            alvo = MODO_DO_PERFIL.get(perfil, 2)
            if atual != alvo:
                ec.set_modo_energia(alvo)
            esperado = alvo
        except OSError:
            pass


def button_thread(get_cfg):
    """Escuta o "TUXEDO Keyboard". Se o dispositivo sumir (driver recarregado), procura de novo."""
    while True:
        path = find_tuxedo_input()
        if path is None:
            time.sleep(10)
            continue
        try:
            for c in key_events(path):
                cfg = get_cfg()
                if cfg.get("botao_keycode") is not None and c == cfg["botao_keycode"]:
                    ULTIMO_BOTAO[0] = time.monotonic()
                    novo = next_perfil(cfg, read_perfil(cfg))
                    write_perfil(novo)
                    print(f"botão: perfil {novo}", flush=True)
                    notify(f"Perfil: {novo}")
        except OSError:
            time.sleep(5)


# ---------------------------------------------------------------- daemon
def daemon():
    cfg = load_config()
    os.makedirs(RUN_DIR, exist_ok=True)
    os.chmod(RUN_DIR, 0o755)
    if not os.path.exists(PERFIL_FILE):
        write_perfil(read_perfil(cfg))
    os.chmod(PERFIL_FILE, 0o666)  # permite "avell-fan perfil" sem sudo

    ec = EC()
    stop = threading.Event()

    def bye(*_):
        stop.set()
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)

    estado = {"cfg": cfg}
    threading.Thread(target=button_thread, args=(lambda: estado["cfg"],), daemon=True).start()
    # pedidos do teclado: a interface escreve sem senha, o serviço valida e aplica
    with open(TECLADO_PEDIDO, "a"):
        pass
    os.chmod(TECLADO_PEDIDO, 0o666)
    restaurar_teclado()

    def teclado_thread():
        while not stop.is_set():
            processar_pedido_teclado()
            stop.wait(0.3)
    threading.Thread(target=teclado_thread, daemon=True).start()
    threading.Thread(target=led_thread, args=(lambda: estado["cfg"], stop), daemon=True).start()

    aplicar_carga(cfg)
    ultima_tomada = None  # None: ainda não leu; a primeira leitura já aplica o perfil da fonte atual

    atual_pct = None
    temp_do_ultimo_aumento = 0
    ultimo_write = 0
    ultimo_perfil = None
    falhas = 0
    em_failsafe = False
    sd_notify("READY=1")
    cfg_mtime = config_mtime()
    try:
        while not stop.is_set():
            try:
                t_cpu, t_gpu = ec.temps()
                falhas = 0
            except OSError:
                falhas += 1
                if falhas >= 3:
                    raise
                stop.wait(cfg["intervalo_s"])
                continue
            temp = max(t_cpu, t_gpu)
            if config_mtime() != cfg_mtime:  # GUI salvou novas curvas
                cfg_mtime = config_mtime()
                cfg = load_config()
                estado["cfg"] = cfg
                atual_pct = None
                aplicar_carga(cfg)
                print("config recarregada", flush=True)
            tomada, bat_pct, bat_estado = energia()
            if tomada is not None and tomada != ultima_tomada:
                auto_perfil = cfg.get("perfil_tomada" if tomada else "perfil_bateria")
                if auto_perfil and (auto_perfil == "auto" or auto_perfil in cfg["perfis"]):
                    write_perfil(auto_perfil)
                    print(f"{'tomada' if tomada else 'bateria'}: perfil {auto_perfil}", flush=True)
                ultima_tomada = tomada
            perfil = read_perfil(cfg)
            if temp >= cfg["temp_failsafe"]:
                em_failsafe = True
            elif temp <= cfg["temp_failsafe"] - cfg["failsafe_saida_c"]:
                em_failsafe = False

            if perfil != ultimo_perfil:
                atual_pct = None
                ultimo_perfil = perfil
                if perfil == "auto":
                    ec.auto()
                try:
                    os.makedirs(os.path.dirname(PERSIST_FILE), exist_ok=True)
                    with open(PERSIST_FILE, "w") as f:
                        f.write(perfil + "\n")
                except OSError:
                    pass

            if perfil == "auto" and not em_failsafe:
                alvo = None
                if atual_pct is not None:  # saiu do failsafe
                    ec.auto()
                    atual_pct = None
            else:
                alvo = 100.0 if em_failsafe else curve(cfg["perfis"][perfil], temp)
                if atual_pct is None or alvo >= atual_pct:
                    if atual_pct is None or alvo > atual_pct:
                        temp_do_ultimo_aumento = temp
                    novo = alvo
                elif temp <= temp_do_ultimo_aumento - cfg["histerese_c"]:
                    novo = max(alvo, atual_pct - cfg["queda_max_pct_por_ciclo"])
                else:
                    novo = atual_pct
                agora = time.monotonic()
                # No Avell o driver usa o "full fan mode" (bit 0x40 do EC 0x0751). Se algo o desligar
                # (botão, suspend), as escritas param de valer sem erro: devolve ao auto e reaplica.
                if atual_pct is not None and not (ec.mode() & 0x40):
                    print("modo manual do EC foi desligado; reaplicando", flush=True)
                    ec.auto()
                    atual_pct = None
                if atual_pct is None or round(novo) != round(atual_pct) or agora - ultimo_write > cfg["reaplicar_s"]:
                    ec.set_pct(novo, cfg["pct_minimo"])
                    ultimo_write = agora
                atual_pct = novo

            try:
                f1, f2 = ec.speeds_pct()
                with open(STATUS_FILE + ".tmp", "w") as f:
                    json.dump({"perfil": perfil, "temp_cpu": t_cpu, "temp_gpu": t_gpu,
                               "alvo_pct": None if atual_pct is None else round(atual_pct),
                               "fan1_pct": f1, "fan2_pct": f2, "tomada": tomada, "bateria_pct": bat_pct,
                               "bateria_estado": bat_estado, "carga": carga_atual(), "ts": time.time()}, f)
                os.replace(STATUS_FILE + ".tmp", STATUS_FILE)
            except OSError:
                pass
            sd_notify("WATCHDOG=1")
            stop.wait(cfg["intervalo_s"])
    finally:
        ec.auto()  # sempre devolve o controle para a BIOS ao sair


# ---------------------------------------------------------------- CLI
def cmd_status():
    try:
        with open(STATUS_FILE) as f:
            s = json.load(f)
        idade = time.time() - s["ts"]
        print(f"perfil:   {s['perfil']}" + ("" if idade < 10 else f"   (daemon parado? status de {idade:.0f}s atrás)"))
        print(f"temp:     CPU {s['temp_cpu']}°C  GPU {s['temp_gpu']}°C")
        alvo = "BIOS" if s["alvo_pct"] is None else f"{s['alvo_pct']}%"
        print(f"fans:     {s['fan1_pct']}% / {s['fan2_pct']}%   (alvo: {alvo})")
        if s.get("bateria_pct") is not None:
            fonte = "tomada" if s.get("tomada") else "bateria"
            lim = CARGAS.get(s.get("carga"))
            print(f"energia:  {fonte} · bateria {s['bateria_pct']}%" + (f" · carga até ~{lim}% ({s['carga']})" if lim else ""))
    except FileNotFoundError:
        if os.geteuid() != 0:
            sys.exit("daemon não está rodando; use sudo para ler direto do EC")
        ec = EC()
        print("temp:", ec.temps(), " fans %:", ec.speeds_pct(), " (daemon parado)")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "ajuda"):
        print(__doc__)
        return
    cmd = args[0]
    cfg = load_config()
    if cmd == "status":
        cmd_status()
    elif cmd == "perfil":
        validos = ["auto"] + list(cfg["perfis"])
        if len(args) < 2 or args[1] not in validos:
            sys.exit(f"uso: avell-fan perfil <{'|'.join(validos)}>")
        if not os.path.exists(PERFIL_FILE):
            sys.exit("daemon não está rodando (sudo systemctl start avell-fan)")
        write_perfil(args[1])
        print("perfil:", args[1])
    elif cmd == "proximo":
        if not os.path.exists(PERFIL_FILE):
            sys.exit("daemon não está rodando (sudo systemctl start avell-fan)")
        novo = next_perfil(cfg, read_perfil(cfg))
        write_perfil(novo)
        print("perfil:", novo)
    elif cmd == "daemon":
        daemon()
    elif cmd == "aplicar-config":
        # usado pela interface via pkexec: lê JSON do stdin, valida e grava /etc/avell-fan.json
        if os.geteuid() != 0:
            sys.exit("precisa de root (a interface usa pkexec)")
        try:
            user = json.loads(sys.stdin.read())
            validate_user_config(user)
        except ValueError as e:
            sys.exit(f"config inválida: {e}")
        tmp = CONFIG_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(user, f, indent=2, ensure_ascii=False)
        os.chmod(tmp, 0o644)
        os.replace(tmp, CONFIG_FILE)
        aplicar_carga(load_config())  # vale na hora, mesmo com o serviço parado
        print("config salva")
    elif cmd == "carga":
        if len(args) < 2:
            atual = carga_atual()
            if atual is None:
                sys.exit("o driver não expõe o perfil de carga neste notebook")
            print(f"carga: {atual} (até ~{CARGAS.get(atual, '?')}%)")
            print("opções: " + ", ".join(f"{k} (~{v}%)" for k, v in CARGAS.items()))
            return
        if args[1] not in CARGAS:
            sys.exit(f"uso: avell-fan carga <{'|'.join(CARGAS)}>")
        if os.geteuid() != 0:
            sys.exit("precisa de root: sudo avell-fan carga " + args[1])
        try:
            with open(CONFIG_FILE) as f:
                user = json.load(f)
        except FileNotFoundError:
            user = {}
        user["carga"] = args[1]
        validate_user_config(user)
        tmp = CONFIG_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(user, f, indent=2, ensure_ascii=False)
        os.chmod(tmp, 0o644)
        os.replace(tmp, CONFIG_FILE)
        aplicar_carga(load_config())  # aplica já, mesmo sem o serviço
        print(f"carga: {args[1]} (até ~{CARGAS[args[1]]}%), salvo em {CONFIG_FILE}")
    elif cmd == "led-teste":
        if os.geteuid() != 0:
            sys.exit("precisa de root: sudo avell-fan led-teste")
        ec = EC()
        original = ec.modo_energia()
        seg = float(args[1]) if len(args) > 1 else 6
        print(f"0x0751 = 0x{ec.mode():02x} (modo de energia: {MODOS_ENERGIA.get(original, ('?',))[0]})")
        try:
            for n, (nome, _) in MODOS_ENERGIA.items():
                ec.set_modo_energia(n)
                time.sleep(0.3)
                print(f"  {n} {nome:9s} -> 0x0751 = 0x{ec.mode():02x}   olhe a luz do botão ({seg:.0f}s)", flush=True)
                time.sleep(seg)
        finally:
            ec.set_modo_energia(original or 2)
            print(f"restaurado: 0x{ec.mode():02x}")
    elif cmd == "versao":
        print(VERSION)
    elif cmd == "teclado":
        e = teclado_estado()
        if len(args) < 2:
            if e["brilho"] is None:
                sys.exit("o driver não expõe o LED do teclado neste notebook")
            print(f"brilho: {e['brilho']}/{e['max']}  cor: {e['cor']}  fn_lock: {'ligado' if e['fn_lock'] else 'desligado'}")
            return
        pedido = {}
        for a in args[1:]:
            if a.startswith("#"):
                pedido["cor"] = a
            elif a.isdigit():
                pedido["brilho"] = int(a)
            else:
                sys.exit("uso: avell-fan teclado [brilho 0-4] [#rrggbb]")
        try:
            pedido = validar_teclado(pedido)
            with open(TECLADO_PEDIDO, "w") as f:
                json.dump(pedido, f)
        except (ValueError, OSError) as e:
            sys.exit(f"não consegui pedir ao serviço: {e}")
        print("pedido enviado ao serviço")
    elif cmd == "auto":
        EC().auto()
        print("fans no automático da BIOS")
    elif cmd == "testar":
        pct = float(args[1]) if len(args) > 1 else 100
        seg = float(args[2]) if len(args) > 2 else 10
        ec = EC()
        linha = lambda: f"  temp {ec.temps()}  fans % {ec.speeds_pct()}  modo 0x{ec.mode():02x}"
        try:
            print("antes:", linha())
            print(f"forçando {pct:.0f}% por {seg:.0f}s...")
            ec.set_pct(pct)
            fim = time.time() + seg
            while time.time() < fim:
                time.sleep(2)
                print(linha())
        finally:
            ec.auto()
            print("de volta ao automático")
            for _ in range(3):
                time.sleep(2)
                print(linha())
    elif cmd == "botao":
        path = find_tuxedo_input()
        if not path:
            sys.exit("dispositivo 'TUXEDO Keyboard' não encontrado (drivers carregados?)")
        ec = EC()
        modo = ec.mode()
        print(f"lendo {path} e o modo do EC (0x{modo:02x}); aperte o botão de fan (Ctrl+C para sair)")
        with open(path, "rb", buffering=0) as f:
            while True:
                r, _, _ = select.select([f], [], [], 0.2)
                if r:
                    data = f.read(EV_SIZE)
                    if len(data) == EV_SIZE:
                        _, _, typ, code, value = struct.unpack(EV_FMT, data)
                        if typ == EV_KEY and value == 1:
                            print("keycode:", code)
                novo = ec.mode()
                if novo != modo:
                    print(f"modo do EC mudou: 0x{modo:02x} -> 0x{novo:02x}")
                    modo = novo
    else:
        sys.exit(f"comando desconhecido: {cmd}\n{__doc__}")


if __name__ == "__main__":
    main()
