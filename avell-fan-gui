        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)

    def _area(self):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        return 40, 8, w - 64, h - 30

    def to_px(self, t, p):
        x0, y0, gw, gh = self._area()
        return x0 + gw * (t - self.T_MIN) / (self.T_MAX - self.T_MIN), y0 + gh * (1 - p / 100)

    def from_px(self, x, y):
        x0, y0, gw, gh = self._area()
        return round(self.T_MIN + (x - x0) / gw * (self.T_MAX - self.T_MIN)), round((1 - (y - y0) / gh) * 100)

    def set_pontos(self, pts):
        self.pontos = [list(p) for p in sorted(pts)]
        self.queue_draw()

    def _hit(self, x, y):
        for i, (t, p) in enumerate(self.pontos):
            px, py = self.to_px(t, p)
            if (px - x) ** 2 + (py - y) ** 2 <= (self.RAIO + 5) ** 2:
                return i
        return None

    def on_press(self, _w, ev):
        i = self._hit(ev.x, ev.y)
        if ev.button == 3 and i is not None and len(self.pontos) > 2:
            del self.pontos[i]
            self._changed()
        elif ev.button == 1 and ev.type == Gdk.EventType._2BUTTON_PRESS and i is None:
            t, p = self.from_px(ev.x, ev.y)
            t = max(self.T_MIN, min(self.T_MAX, t))
            if all(pt[0] != t for pt in self.pontos):
                self.pontos.append([t, max(0, min(100, p))])
                self.pontos.sort()
                for k in range(1, len(self.pontos)):
                    self.pontos[k][1] = max(self.pontos[k][1], self.pontos[k - 1][1])
                self._changed()
        elif ev.button == 1 and i is not None:
            self.arrastando = i
            self.queue_draw()
        return True

    def on_release(self, *_):
        self.arrastando = None
        self.queue_draw()

    def on_motion(self, _w, ev):
        i = self.arrastando
        if i is None:
            win = self.get_window()
            if win:
                nome = "grab" if self._hit(ev.x, ev.y) is not None else "default"
                win.set_cursor(Gdk.Cursor.new_from_name(self.get_display(), nome))
            return
        t, p = self.from_px(ev.x, ev.y)
        t_lo = self.pontos[i - 1][0] + 1 if i > 0 else self.T_MIN
        t_hi = self.pontos[i + 1][0] - 1 if i < len(self.pontos) - 1 else self.T_MAX
        p_lo = self.pontos[i - 1][1] if i > 0 else 0
        p_hi = self.pontos[i + 1][1] if i < len(self.pontos) - 1 else 100
        self.pontos[i] = [max(t_lo, min(t_hi, t)), max(p_lo, min(p_hi, p))]
        self._changed()

    def _changed(self):
        self.queue_draw()
        self.on_change()

    def on_draw(self, _w, cr):
        x0, y0, gw, gh = self._area()
        cairo_font(cr, 10)
        fx, _ = self.to_px(self.failsafe, 0)
        cr.set_source_rgba(*rgb(T["danger"], .08)); cr.rectangle(fx, y0, x0 + gw - fx, gh); cr.fill()
        cr.set_source_rgba(*rgb(T["danger"])); cr.move_to(fx + 8, y0 + 14); cr.show_text("FAILSAFE 100%")
        cr.set_line_width(1)
        for p in (0, 25, 50, 75, 100):
            _, py = self.to_px(self.T_MIN, p)
            cr.set_source_rgba(*rgb(T["line"])); cr.move_to(x0, py + .5); cr.line_to(x0 + gw, py + .5); cr.stroke()
        for p, dx in ((100, 0), (50, 6), (0, 14)):
            _, py = self.to_px(self.T_MIN, p)
            cr.set_source_rgba(*rgb(T["ink3"])); cr.move_to(dx, py + 4); cr.show_text(f"{p}%")
        for t in range(self.T_MIN, self.T_MAX + 1, 10):
            px, _ = self.to_px(t, 0)
            cr.set_source_rgba(*rgb(T["ink3"])); cr.move_to(px - 8, y0 + gh + 18); cr.show_text(f"{t}°")
        _, my = self.to_px(0, self.pct_minimo)
        cr.set_source_rgba(*rgb(T["ink3"])); cr.set_dash([2, 3]); cr.move_to(x0, my); cr.line_to(x0 + gw, my); cr.stroke()
        cr.set_dash([]); cr.move_to(x0 + 6, my - 5); cr.show_text(f"MÍNIMO {self.pct_minimo}%")
        if self.temp_atual is not None:
            tx, _ = self.to_px(max(self.T_MIN, min(self.T_MAX, self.temp_atual)), 0)
            cr.set_source_rgba(*rgb(C_CPU)); cr.set_line_width(1.5)
            cr.move_to(tx, y0); cr.line_to(tx, y0 + gh); cr.stroke()
            cr.move_to(tx + 6, y0 + gh - 6); cr.show_text(f"AGORA {self.temp_atual}°C")
        if not self.pontos:
            return
        pts = self.pontos
        cr.set_source_rgba(*rgb(C_FAN)); cr.set_line_width(2.5); cr.set_line_join(1)
        cr.move_to(*self.to_px(self.T_MIN, pts[0][1]))
        for t, p in pts:
            cr.line_to(*self.to_px(t, p))
        cr.line_to(*self.to_px(self.T_MAX, pts[-1][1]))
        cr.stroke()
        for i, (t, p) in enumerate(pts):
            px, py = self.to_px(t, p)
            cr.arc(px, py, self.RAIO + (1 if i == self.arrastando else 0), 0, 6.2832)
            cr.set_source_rgba(*rgb(C_FAN)); cr.fill_preserve()
            cr.set_source_rgba(*rgb(T["bg"])); cr.set_line_width(2.5); cr.stroke()
            if i == self.arrastando:
                cr.set_source_rgba(*rgb(T["ink"])); cr.move_to(px + 12, py - 10); cr.show_text(f"{t}°C → {p}%")


class Banner(Gtk.Box):
    def __init__(self):
        super().__init__(spacing=12)
        cls(self, "banner")
        self.icon = label("", markup=True)
        self.msg = label("")
        self.msg.set_line_wrap(True)
        self.btn = cls(Gtk.Button(label="Iniciar serviço"), "secondary")
        self.btn.connect("clicked", lambda *_: executar_root(
            ["systemctl", "start", "avell-fan"], None,
            lambda ok, msg: None if ok else self.show_msg(msg, "warning", iniciar=True)))
        close = cls(Gtk.Button(label="✕"), "ghost")
        close.connect("clicked", lambda *_: self.hide())
        self.pack_start(self.icon, False, False, 0)
        self.pack_start(self.msg, True, True, 0)
        self.pack_start(self.btn, False, False, 0)
        self.pack_start(close, False, False, 0)
        self.set_no_show_all(True)
        self.kind = None

    def show_msg(self, texto, kind="info", iniciar=False):
        ctx = self.get_style_context()
        for k in ("info", "warning", "error"):
            ctx.remove_class(k)
        ctx.add_class(kind)
        cor = {"info": T["info"], "warning": T["warning"], "error": T["danger"]}[kind]
        self.icon.set_markup(f'<span foreground="{cor}">●</span>')
        self.msg.set_text(texto)
        self.kind = "parado" if iniciar else kind
        for wdg in (self.icon, self.msg):
            wdg.show()
        self.btn.set_visible(iniciar)
        self.get_children()[-1].show()
        self.show()


