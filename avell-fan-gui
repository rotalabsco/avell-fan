    # ---------------------------------------------------------------- curvas
    def carregar_curvas(self):
        cfg = core.load_config()
        self.curvas_salvas = {n: [list(p) for p in cfg["perfis"][n]] for n in EDITAVEIS}
        self.curvas_edit = json.loads(json.dumps(self.curvas_salvas))
        self.editor.failsafe = self.grafico.failsafe = cfg["temp_failsafe"]
        self.editor.pct_minimo = cfg.get("pct_minimo", 25)

    def aba(self):
        return next(n for n, tb in self.tabs.items() if tb.get_active())

    def on_tab(self, tb, nome):
        if tb.get_active():
            self.editor.set_pontos(self.curvas_edit[nome])
            self.atualizar_botoes()

    def on_curva_editada(self):
        self.curvas_edit[self.aba()] = [list(p) for p in self.editor.pontos]
        self.atualizar_botoes()

    def atualizar_botoes(self):
        alterados = [NOME[n] for n in EDITAVEIS if self.curvas_edit[n] != self.curvas_salvas[n]]
        self.b_salvar.set_sensitive(bool(alterados))
        self.b_desfazer.set_sensitive(bool(alterados))
        self.lbl_alter.set_markup(f"<i>Não salvo: {', '.join(alterados)}</i>" if alterados
                                  else f"<i>Curva {NOME[self.aba()]} sem alterações</i>")

    def on_padrao(self, _b):
        n = self.aba()
        self.curvas_edit[n] = [list(p) for p in core.DEFAULT_CONFIG["perfis"][n]]
        self.editor.set_pontos(self.curvas_edit[n])
        self.atualizar_botoes()

    def on_desfazer(self, _b):
        self.curvas_edit = json.loads(json.dumps(self.curvas_salvas))
        self.editor.set_pontos(self.curvas_edit[self.aba()])
        self.atualizar_botoes()

    def on_salvar(self, _b):
        user = user_config()
        user.setdefault("perfis", {})
        for n in EDITAVEIS:
            if self.curvas_edit[n] == [list(p) for p in core.DEFAULT_CONFIG["perfis"][n]]:
                user["perfis"].pop(n, None)
            else:
                user["perfis"][n] = self.curvas_edit[n]
        if not user["perfis"]:
            del user["perfis"]
        try:
            core.validate_user_config(user)
        except ValueError as e:
            return self.banner.show_msg(str(e), "error")
        r = subprocess.run(["pkexec", CORE_BIN, "aplicar-config"], input=json.dumps(user),
                           capture_output=True, text=True)
        if r.returncode == 0:
            self.carregar_curvas()
            self.editor.set_pontos(self.curvas_edit[self.aba()])
            self.atualizar_botoes()
            self.banner.show_msg("Curvas salvas. O serviço já está usando.", "info")
        elif r.returncode in (126, 127):
            self.banner.show_msg("Salvamento cancelado: a senha não foi confirmada.", "warning")
        else:
            self.banner.show_msg(f"Erro ao salvar: {(r.stderr or r.stdout).strip()}", "error")

    # ---------------------------------------------------------------- status
    def on_perfil_toggled(self, rb, nome):
        if rb.get_active() and not self._sync:
            erro = set_perfil(nome)
            if erro:
                self.banner.show_msg(erro, "error")
            self.app.atualizar()

    def atualizar(self, s):
        if s is None:
            self.pill.set_markup(f'<span foreground="{T["warning"]}">●</span>  Serviço parado')
            if self.banner.kind != "parado" or not self.banner.get_visible():
                self.banner.show_msg("O serviço avell-fan não está rodando. Os fans estão no automático da BIOS.",
                                     "warning", iniciar=True)
            for c in (self.card_cpu, self.card_gpu, self.card_fan1, self.card_fan2):
                c.set(None, "", 0)
            return
        if self.banner.kind == "parado" and self.banner.get_visible():
            self.banner.hide()
            self.banner.kind = None
        alvo = "BIOS" if s["alvo_pct"] is None else f"alvo {s['alvo_pct']}%"
        self.pill.set_markup(f'<span foreground="{T["success"]}">●</span>  Serviço ativo · {alvo}')
        self.card_cpu.set(s["temp_cpu"], "°C", s["temp_cpu"] / 100)
        self.card_gpu.set(s["temp_gpu"], "°C", s["temp_gpu"] / 100)
        self.card_fan1.set(s["fan1_pct"], "%", s["fan1_pct"] / 100)
        self.card_fan2.set(s["fan2_pct"], "%", s["fan2_pct"] / 100)
        self.editor.temp_atual = max(s["temp_cpu"], s["temp_gpu"])
        self.editor.queue_draw()
        self.grafico.queue_draw()
        rb = self.radios.get(s["perfil"])
        if rb and not rb.get_active():
            self._sync = True
            rb.set_active(True)
            self._sync = False

    def on_close(self, *_):
        if self.app.tem_bandeja:
            self.hide()  # continua na bandeja
            return True
        return False


