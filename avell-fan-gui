def rgb(hexcor, a=1.0):
    h = hexcor.lstrip("#")
    return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255, a)


def svg_pixbuf(data, size):
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.set_size(size, size)
    loader.write(data)
    loader.close()
    return loader.get_pixbuf()


def icon_image(size):
    if os.path.isabs(ICON):
        with open(ICON, "rb") as f:
            return Gtk.Image.new_from_pixbuf(svg_pixbuf(f.read(), size))
    return Gtk.Image.new_from_icon_name(ICON, Gtk.IconSize.DND)


def label(text="", *classes, xalign=0.0, markup=False):
    lb = Gtk.Label(xalign=xalign)
    (lb.set_markup if markup else lb.set_text)(text)
    for c in classes:
        lb.get_style_context().add_class(c)
    return lb


def cls(widget, *classes):
    for c in classes:
        widget.get_style_context().add_class(c)
    return widget


def dot(cor):
    return label(f'<span foreground="{cor}">●</span>', markup=True)


def modelo_notebook():
    try:
        with open("/sys/class/dmi/id/product_name") as f:
            nome = f.read().strip()
    except OSError:
        nome = ""
    return " · ".join(x for x in (nome.upper(), "UNIWILL", "TUXEDO_IO") if x)


def read_status():
    try:
        with open(core.STATUS_FILE) as f:
            s = json.load(f)
        if time.time() - s.get("ts", 0) > 10:
            return None
        return s
    except (OSError, ValueError):
        return None


def set_perfil(nome):
    try:
        core.write_perfil(nome)
        return None
    except OSError:
        return "Não consegui trocar o perfil. O serviço avell-fan está rodando?"


def user_config():
    try:
        with open(core.CONFIG_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def cairo_font(cr, size, family="Geist Mono"):
    import cairo
    cr.select_font_face(family, cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)


