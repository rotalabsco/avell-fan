def executar_root(args, entrada, ao_terminar):
    """pkexec sem travar a janela. ao_terminar(ok, msg) roda no loop do GTK.

    --disable-internal-agent: sem a janela de senha do desktop, o pkexec falha na hora
    em vez de esperar a senha num terminal (o que congelava a interface)."""
    flags = Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
    try:
        proc = Gio.Subprocess.new(["pkexec", "--disable-internal-agent"] + args, flags)
    except GLib.Error as e:
        return ao_terminar(False, f"Não consegui rodar o pkexec: {e.message}")

    def fim(p, res):
        try:
            _ok, out, err = p.communicate_utf8_finish(res)
        except GLib.Error as e:
            return ao_terminar(False, e.message)
        rc = p.get_exit_status()
        texto = ((err or "") + (out or "")).strip()
        if rc == 0:
            ao_terminar(True, texto)
        elif "authentication agent" in texto.lower():
            ao_terminar(False, "Sem janela de senha: abra o Avell Fan pelo menu de aplicativos (aberto pelo "
                               "terminal, o Linux não mostra o pedido de senha).")
        elif rc in (126, 127):
            ao_terminar(False, "Cancelado: a senha não foi confirmada.")
        else:
            ao_terminar(False, f"Erro: {texto or rc}")
    proc.communicate_utf8_async(entrada, None, fim)


def pedir_teclado(pedido):
    try:
        # junta com um pedido que o serviço ainda não leu (cliques rápidos)
        try:
            with open(core.TECLADO_PEDIDO) as f:
                pendente = json.loads(f.read(4096) or "{}")
        except (OSError, ValueError):
            pendente = {}
        if isinstance(pendente, dict):
            pendente.update(pedido)
            pedido = pendente
        with open(core.TECLADO_PEDIDO, "w") as f:
            json.dump(pedido, f)
        return None
    except OSError:
        return "Não consegui mudar o teclado. O serviço avell-fan está rodando?"


