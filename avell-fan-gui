def rgb(hexcor, a=1.0):
    h = hexcor.lstrip("#")
    return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255, a)


def svg_pixbuf(data, size):
    loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
    loader.set_size(size, size)
    loader.write(data)
    loader.close()
    return loader.get_pixbuf()


def icon_image(size):
    if os.path.isabs(ICON):
        with open(ICON, "rb") as f:
            return Gtk.Image.new_from_pixbuf(svg_pixbuf(f.read(), size))
    return Gtk.Image.new_from_icon_name(ICON, Gtk.IconSize.DND)


def label(text="", *classes, xalign=0.0, markup=False):
    lb = Gtk.Label(xalign=xalign)
    (lb.set_markup if markup else lb.set_text)(text)
    for c in classes:
        lb.get_style_context().add_class(c)
    return lb


def cls(widget, *classes):
