class Card(Gtk.Box):
    def __init__(self, titulo, cor, tipo):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        cls(self, "card", tipo)
        self.tipo = tipo
        top = Gtk.Box(spacing=8)
        self.dot = dot(cor)
        top.pack_start(self.dot, False, False, 0)
        top.pack_start(label(titulo, "overline"), False, False, 0)
        val = Gtk.Box(spacing=4)
        self.valor = label("—", "big")
        self.valor.set_valign(Gtk.Align.BASELINE)
        self.unidade = label("", "unit")
        self.unidade.set_valign(Gtk.Align.BASELINE)
        val.pack_start(self.valor, False, False, 0)
        val.pack_start(self.unidade, False, False, 0)
        self.barra = Gtk.ProgressBar()
        self.pack_start(top, False, False, 0)
        self.pack_start(val, False, False, 0)
        self.pack_start(self.barra, False, False, 0)

    def set(self, valor, unidade, frac):
        ctx = self.get_style_context()
        if valor is None:
            self.valor.set_text("—"); self.unidade.set_text(""); self.barra.set_fraction(0)
            ctx.remove_class(self.tipo); ctx.add_class("off")
        else:
            self.valor.set_text(str(valor)); self.unidade.set_text(unidade)
            self.barra.set_fraction(max(0, min(1, frac)))
            ctx.remove_class("off"); ctx.add_class(self.tipo)


class Grafico(Gtk.DrawingArea):
    """Histórico: temp CPU, temp GPU e % do fan na mesma escala 0–100."""

    def __init__(self):
        super().__init__()
        self.set_size_request(-1, 150)
        self.hist = collections.deque(maxlen=HIST_S)
        self.failsafe = 90
        self.connect("draw", self.on_draw)

    def push(self, amostra):
        self.hist.append(amostra)
        self.queue_draw()

    def on_draw(self, _w, cr):
        w, h = self.get_allocated_width(), self.get_allocated_height()
        x0, y0, gw, gh = 32, 6, w - 32, h - 14
        y = lambda v: y0 + gh * (1 - max(0, min(100, v)) / 100)
        cairo_font(cr, 10)
        cr.set_line_width(1)
        for v in (0, 25, 50, 75, 100):
            cr.set_source_rgba(*rgb(T["line"])); cr.move_to(x0, y(v) + .5); cr.line_to(w, y(v) + .5); cr.stroke()
        for v, dx in ((100, 0), (50, 6), (0, 12)):
            cr.set_source_rgba(*rgb(T["ink3"])); cr.move_to(dx, y(v) + 4); cr.show_text(str(v))
        cr.set_source_rgba(*rgb(T["danger"], .7)); cr.set_line_width(1.5); cr.set_dash([5, 4])
        cr.move_to(x0, y(self.failsafe)); cr.line_to(w, y(self.failsafe)); cr.stroke(); cr.set_dash([])
        n = len(self.hist)
        if n < 2:
            cr.set_source_rgba(*rgb(T["ink3"])); cairo_font(cr, 12, FONTE["texto"])
            cr.move_to(x0 + 12, y0 + gh / 2); cr.show_text("Aguardando leituras…")
            return
        x = lambda i: x0 + gw * (HIST_S - n + i) / (HIST_S - 1)
        for idx, cor, lw in ((2, C_FAN, 2), (1, C_GPU, 2), (0, C_CPU, 2.25)):
            cr.set_source_rgba(*rgb(cor)); cr.set_line_width(lw); cr.set_line_join(1)
            for i, a in enumerate(self.hist):
                (cr.move_to if i == 0 else cr.line_to)(x(i), y(a[idx]))
            cr.stroke()


