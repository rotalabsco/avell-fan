        return e

    def carregar_energia(self):
        cfg = core.load_config()
        self._carregando = True
        for k, cb in self.combos.items():
            cb.set_active_id(cfg.get(k) or "")
        self.energia_salva = {k: cfg.get(k) for k in self.combos}
        if self.tem_carga:
            # sem "carga" na config, mostra o que está no EC agora
            atual = cfg.get("carga") or core.carga_atual()
            if atual in self.cargas:
                self.cargas[atual].set_active(True)
            self.energia_salva["carga"] = atual
        self._carregando = False
        self.atualizar_energia_botoes()

    def atualizar_energia_botoes(self):
        if getattr(self, "_carregando", False) or not hasattr(self, "energia_salva"):
            return
        mudou = self.energia_editada() != self.energia_salva
        self.b_energia_salvar.set_sensitive(mudou)
        self.b_energia_desfazer.set_sensitive(mudou)
        self.lbl_energia_alter.set_markup("<i>Não salvo</i>" if mudou else "")

    def on_salvar_energia(self, _b):
        user = user_config()
        for k, v in self.energia_editada().items():
            if v is None:
                user.pop(k, None)
            else:
                user[k] = v
        try:
            core.validate_user_config(user)
        except ValueError as e:
            return self.banner.show_msg(str(e), "error")
        self.b_energia_salvar.set_sensitive(False)
        self.lbl_energia_alter.set_markup("<i>Aguardando a senha…</i>")

        def fim(ok, msg):
            if ok:
                self.carregar_energia()
                self.banner.show_msg("Energia salva. O limite de carga já vale.", "info")
            else:
                self.banner.show_msg(msg, "warning")
                self.atualizar_energia_botoes()
        executar_root([CORE_BIN, "aplicar-config"], json.dumps(user), fim)

    def mostrar_energia(self):
        tomada, bat, estado = core.energia()
        partes = []
        if tomada is not None:
            partes.append(f'<span foreground="{T["success"] if tomada else T["warning"]}">●</span>  '
                          + ("Na tomada" if tomada else "Na bateria"))
        if bat is not None:
            est = {"Charging": "carregando", "Discharging": "descarregando", "Full": "carregada",
                   "Not charging": "sem carregar"}.get(estado, "")
            partes.append(f"bateria {bat}%" + (f" · {est}" if est else ""))
        self.lbl_energia.set_markup(" · ".join(partes))

    # ---------------------------------------------------------------- teclado
    def criar_teclado(self):
        e = core.teclado_estado()
        self.tecl_mexido = 0.0
        card = cls(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14), "card")
        top = Gtk.Box(spacing=12)
        top.pack_start(label("Teclado", "h3"), False, False, 0)
        top.pack_start(Gtk.Box(), True, True, 0)
        top.pack_start(label("Muda na hora, sem senha · as teclas Fn de brilho continuam funcionando", "muted"),
                       False, False, 0)
        card.pack_start(top, False, False, 0)
        if e["brilho"] is None:
            card.pack_start(label("O driver não expõe a luz do teclado neste notebook.", "muted"), False, False, 0)
            self.brilhos = {}
            self.sw_fn = None
            return card

        card.pack_start(label("BRILHO", "overline"), False, False, 0)
        seg = cls(Gtk.Box(spacing=4, homogeneous=True), "segmented")
        self.brilhos = {}
        g = None
        for n in range(0, (e["max"] or 4) + 1):
            rb = Gtk.RadioButton.new_from_widget(g)
            rb.set_mode(False)
            rb.add(label("Desligado" if n == 0 else f"{n}", "seg-title", xalign=0.5))
            rb.connect("toggled", self.on_brilho, n)
            g = g or rb
            seg.pack_start(rb, True, True, 0)
            self.brilhos[n] = rb
        card.pack_start(seg, False, False, 0)

        card.pack_start(label("COR", "overline"), False, False, 0)
        cores = Gtk.Box(spacing=10)
        self.swatches = {}
        for hexcor, nome in CORES_TECLADO:
            b = cls(Gtk.ToggleButton(), "swatch")
            b.set_tooltip_text(nome)
            prov = Gtk.CssProvider()
            prov.load_from_data(f"button.swatch {{ background: {hexcor}; }}".encode())
            b.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            b.connect("toggled", self.on_swatch, hexcor)
            cores.pack_start(b, False, False, 0)
            self.swatches[hexcor] = b
        self.cor_custom = cls(Gtk.ColorButton(), "secondary")
        self.cor_custom.set_title("Cor do teclado")
        self.cor_custom.connect("color-set", self.on_cor_custom)
        cores.pack_start(self.cor_custom, False, False, 0)
        cores.pack_start(label("Outra cor", "muted"), False, False, 0)
        card.pack_start(cores, False, False, 0)

        if e["fn_lock"] is not None:
            fl = Gtk.Box(spacing=12)
            txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            txt.pack_start(label("Fn Lock", "seg-title"), False, False, 0)
            txt.pack_start(label("F1–F12 funcionam como teclas de função sem segurar o Fn", "muted"), False, False, 0)
            fl.pack_start(txt, True, True, 0)
            self.sw_fn = Gtk.Switch(valign=Gtk.Align.CENTER)
            self.sw_fn.connect("notify::active", self.on_fn_lock)
            fl.pack_start(self.sw_fn, False, False, 0)
            card.pack_start(fl, False, False, 0)
        else:
            self.sw_fn = None
        self.mostrar_teclado(forcar=True)
        return card

    def criar_botao(self):
        card = cls(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10), "card")
        linha = Gtk.Box(spacing=12)
        txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        txt.pack_start(label("Botão de modo do notebook", "h3"), False, False, 0)
        ciclo = " → ".join(NOME.get(p, p) for p in core.load_config()["ciclo"])
        d = label(f"O botão ao lado do power alterna os perfis: {ciclo}. Aparece uma notificação a cada troca.",
                  "muted")
        d.set_line_wrap(True)
        txt.pack_start(d, False, False, 0)
        linha.pack_start(txt, True, True, 0)
        self.sw_botao = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.sw_botao.set_active(core.load_config().get("botao_keycode") is not None)
        self.sw_botao.connect("state-set", self.on_botao)
        linha.pack_start(self.sw_botao, False, False, 0)
        card.pack_start(linha, False, False, 0)
        return card

    def on_botao(self, sw, ligado):
        user = user_config()
        if ligado:
            user.pop("botao_keycode", None)  # volta ao padrão (KEY_F6 do "TUXEDO Keyboard")
        else:
            user["botao_keycode"] = None

        def fim(ok, msg):
            if ok:
                sw.set_state(ligado)
                self.banner.show_msg("Botão " + ("ativado." if ligado else "desativado."), "info")
            else:
                sw.set_active(not ligado)
                sw.set_state(not ligado)
                self.banner.show_msg(msg, "warning")
        executar_root([CORE_BIN, "aplicar-config"], json.dumps(user), fim)
        return True  # o estado só muda depois da senha

    def _pedir(self, pedido):
        if self._sync:
            return
        self.tecl_mexido = time.monotonic()
        erro = pedir_teclado(pedido)
        if erro:
            self.banner.show_msg(erro, "error")

    def on_brilho(self, rb, n):
        if rb.get_active():
            self._pedir({"brilho": n})

    def on_swatch(self, b, hexcor):
        if self._sync:
            return
        if b.get_active():
            self._sync = True
            for h, o in self.swatches.items():
                o.set_active(h == hexcor)
            self._sync = False
            pedido = {"cor": hexcor}
            if self.brilhos and self.brilhos[0].get_active():
                pedido["brilho"] = max(self.brilhos)  # escolher cor com a luz apagada acende
            self._pedir(pedido)
        elif not any(o.get_active() for o in self.swatches.values()):
            self._sync = True
            b.set_active(True)  # sempre um selecionado
            self._sync = False

    def on_cor_custom(self, cb):
        c = cb.get_rgba()
        hexcor = "#%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255))
        self._sync = True
        for o in self.swatches.values():
            o.set_active(False)
        self._sync = False
        self._pedir({"cor": hexcor})

    def on_fn_lock(self, sw, _p):
        self._pedir({"fn_lock": sw.get_active()})

    def mostrar_teclado(self, forcar=False):
        if not self.brilhos or (not forcar and time.monotonic() - self.tecl_mexido < 4):
            return  # dá tempo ao serviço de aplicar o pedido antes de reler
        e = core.teclado_estado()
        self._sync = True
        if e["brilho"] in self.brilhos:
            self.brilhos[e["brilho"]].set_active(True)
        if e["cor"]:
            for h, o in self.swatches.items():
                o.set_active(h == e["cor"])
            rgba = Gdk.RGBA()
            rgba.parse(e["cor"])
            self.cor_custom.set_rgba(rgba)
        if self.sw_fn is not None and e["fn_lock"] is not None:
            self.sw_fn.set_active(e["fn_lock"])
        self._sync = False

    # ---------------------------------------------------------------- status
    def on_perfil_toggled(self, rb, nome):
        if rb.get_active() and not self._sync:
            erro = set_perfil(nome)
            if erro:
                self.banner.show_msg(erro, "error")
            self.app.atualizar()

    def atualizar(self, s):
        self.mostrar_energia()
        self.mostrar_teclado()
        if s is None:
            self.pill.set_markup(f'<span foreground="{T["warning"]}">●</span>  Serviço parado')
            if self.banner.kind != "parado" or not self.banner.get_visible():
                self.banner.show_msg("O serviço avell-fan não está rodando. Os fans estão no automático da BIOS.",
                                     "warning", iniciar=True)
            for c in (self.card_cpu, self.card_gpu, self.card_fan1, self.card_fan2):
                c.set(None, "", 0)
            return
        if self.banner.kind == "parado" and self.banner.get_visible():
            self.banner.hide()
            self.banner.kind = None
        alvo = "BIOS" if s["alvo_pct"] is None else f"alvo {s['alvo_pct']}%"
        self.pill.set_markup(f'<span foreground="{T["success"]}">●</span>  Serviço ativo · {alvo}')
        self.card_cpu.set(s["temp_cpu"], "°C", s["temp_cpu"] / 100)
        self.card_gpu.set(s["temp_gpu"], "°C", s["temp_gpu"] / 100)
        self.card_fan1.set(s["fan1_pct"], "%", s["fan1_pct"] / 100)
        self.card_fan2.set(s["fan2_pct"], "%", s["fan2_pct"] / 100)
        self.editor.temp_atual = max(s["temp_cpu"], s["temp_gpu"])
        self.editor.queue_draw()
        self.grafico.queue_draw()
        rb = self.radios.get(s["perfil"])
        if rb and not rb.get_active():
            self._sync = True
            rb.set_active(True)
            self._sync = False

    def on_close(self, *_):
        if self.app.tem_bandeja:
            self.hide()  # continua na bandeja
            aviso = os.path.expanduser("~/.config/avell-fan/bandeja-avisado")
            if not os.path.exists(aviso):
                n = Gio.Notification.new("Avell Fan continua na bandeja")
                n.set_body("O controle dos fans segue ativo. Clique no ícone da bandeja para abrir de novo.")
                self.app.send_notification("bandeja", n)
                try:
                    os.makedirs(os.path.dirname(aviso), exist_ok=True)
                    open(aviso, "w").close()
                except OSError:
                    pass
            return True
        return False


# ======================================================================== painel da bandeja
class PainelBandeja(Gtk.Window):
    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.app = app
        cls(self, "avell-pop")
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        # DIALOG (e não POPUP_MENU): no Cinnamon só assim a janela recebe foco e fecha ao clicar fora
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_default_size(320, -1)
        self.connect("focus-out-event", lambda *_: self.hide())
        self.connect("key-press-event", lambda _w, e: e.keyval == Gdk.KEY_Escape and self.hide())
        self._sync = False

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=8)
        self.add(box)
        head = cls(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "pop-head")
        l1 = Gtk.Box(spacing=8)
        l1.pack_start(label("Avell Fan", "h3"), False, False, 0)
        l1.pack_start(Gtk.Box(), True, True, 0)
        self.estado = label("", "legend", markup=True)
        l1.pack_start(self.estado, False, False, 0)
        head.pack_start(l1, False, False, 0)
        g = Gtk.Grid(column_homogeneous=True, column_spacing=8)
        self.vals = {}
        for i, (k, cor) in enumerate((("CPU", C_CPU), ("GPU", C_GPU), ("FAN", C_FAN))):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            col.pack_start(label(k, "overline"), False, False, 0)
            v = label("—", "pop-big", markup=True)
            col.pack_start(v, False, False, 0)
            self.vals[k] = (v, cor)
            g.attach(col, i, 0, 1, 1)
        head.pack_start(g, False, False, 0)
        box.pack_start(head, False, False, 0)

        ov = label("PERFIL", "overline")
        ov.set_margin_start(12); ov.set_margin_top(8)
        box.pack_start(ov, False, False, 0)
        self.items = {}
        grupo = None
        for nome, titulo, _ in PERFIS_UI:
            rb = Gtk.RadioButton.new_with_label_from_widget(grupo, titulo if nome != "auto" else "Automático (BIOS)")
            rb.set_mode(False)
            cls(rb, "pop-item")
            rb.get_child().set_xalign(0)
            rb.connect("toggled", self.on_item, nome)
            grupo = grupo or rb
            box.pack_start(rb, False, False, 0)
            self.items[nome] = rb

        sep = cls(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2), "pop-sep")
        sep.set_margin_top(8)
        abrir = cls(Gtk.Button(label="Abrir janela"), "pop-item")
        abrir.get_child().set_xalign(0)
        abrir.connect("clicked", lambda *_: (self.hide(), self.app.activate()))
        sair = cls(Gtk.Button(label="Sair da interface"), "pop-item", "dim")
        sair.get_child().set_xalign(0)
        sair.connect("clicked", lambda *_: self.app.quit())
        sep.pack_start(abrir, False, False, 0)
        sep.pack_start(sair, False, False, 0)
        box.pack_start(sep, False, False, 0)
        box.show_all()

    def on_item(self, rb, nome):
        if rb.get_active() and not self._sync:
            set_perfil(nome)
            self.app.atualizar()

    def atualizar(self, s):
        if s is None:
            self.estado.set_markup(f'<span foreground="{T["warning"]}">●</span> parado')
            for v, _ in self.vals.values():
                v.set_text("—")
            return
        self.estado.set_markup(f'<span foreground="{T["success"]}">●</span> ativo')
        fan = max(s["fan1_pct"], s["fan2_pct"])
        for k, val in (("CPU", f"{s['temp_cpu']}°"), ("GPU", f"{s['temp_gpu']}°"), ("FAN", f"{fan}%")):
            v, cor = self.vals[k]
            v.set_markup(f'<span foreground="{cor}">{val}</span>')
        rb = self.items.get(s["perfil"])
        if rb and not rb.get_active():
            self._sync = True
            rb.set_active(True)
            self._sync = False

    def mostrar_em(self, x, y, posicao_painel):
        self.show()
        w, h = self.get_size()
        geo = Gdk.Display.get_default().get_monitor_at_point(x, y).get_geometry()
        # posicao_painel (Gtk.PositionType): BOTTOM=3 → abre acima do ícone
        if posicao_painel == Gtk.PositionType.BOTTOM:
            px, py = x - w // 2, y - h - 8
        elif posicao_painel == Gtk.PositionType.TOP:
            px, py = x - w // 2, y + 8
        elif posicao_painel == Gtk.PositionType.LEFT:
            px, py = x + 8, y - h // 2
        else:
            px, py = x - w - 8, y - h // 2
        px = max(geo.x + 8, min(px, geo.x + geo.width - w - 8))
        py = max(geo.y + 8, min(py, geo.y + geo.height - h - 8))
        self.move(px, py)
        self.present_with_time(Gtk.get_current_event_time())


# ======================================================================== app
class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="co.rotalabs.AvellFan")
        self.janela = None
        self.painel = None
        self.status_icon = None
        self.indicator = None
        self.bandeja_inicial = "--bandeja" in sys.argv
        self.hist_pendente = collections.deque(maxlen=HIST_S)

    @property
    def tem_bandeja(self):
        return self.status_icon is not None or self.indicator is not None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", ESCURO)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.criar_bandeja()
        if self.tem_bandeja:
            self.hold()
        GLib.timeout_add(POLL_MS, self.atualizar)

    def do_activate(self):
        if self.janela is None:
            self.janela = Janela(self)
            self.janela.grafico.hist.extend(self.hist_pendente)
            if self.bandeja_inicial and self.tem_bandeja:
                self.janela.hide()
                self.bandeja_inicial = False
                return
        self.janela.show()
        self.janela.present()
        self.atualizar()

    def criar_bandeja(self):
        if XApp is not None:
            self.painel = PainelBandeja(self)
            si = XApp.StatusIcon()
            si.set_name("avell-fan")
            no_tema = Gtk.IconTheme.get_default().has_icon("avell-fan")
            si.set_icon_name("avell-fan" if no_tema else ICON)
            si.set_tooltip_text("Avell Fan")
            si.connect("button-release-event", self.on_tray_click)
            si.set_visible(True)
            self.status_icon = si
        elif AppIndicator is not None:
            ind = AppIndicator.Indicator.new("avell-fan", ICON, AppIndicator.IndicatorCategory.HARDWARE)
            ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
            menu = Gtk.Menu()
            for nome, titulo, _ in PERFIS_UI:
                mi = Gtk.MenuItem(label=titulo)
                mi.connect("activate", lambda _m, n=nome: (set_perfil(n), self.atualizar()))
                menu.append(mi)
            menu.append(Gtk.SeparatorMenuItem())
            abrir = Gtk.MenuItem(label="Abrir janela")
            abrir.connect("activate", lambda *_: self.activate())
            menu.append(abrir)
            sair = Gtk.MenuItem(label="Sair da interface")
            sair.connect("activate", lambda *_: self.quit())
            menu.append(sair)
            menu.show_all()
            ind.set_menu(menu)
            self.indicator = ind

    def on_tray_click(self, _icon, x, y, button, _time, panel_pos):
        if button == 1:
            if self.painel.get_visible():
                self.painel.hide()
            else:
                self.atualizar()
                self.painel.mostrar_em(x, y, panel_pos)
        elif button == 3:
            self.activate()

    def atualizar(self):
        s = read_status()
        if s is not None:
            amostra = (s["temp_cpu"], s["temp_gpu"], max(s["fan1_pct"], s["fan2_pct"]))
            (self.janela.grafico.hist if self.janela else self.hist_pendente).append(amostra)
        if self.janela is not None and self.janela.get_visible():
            self.janela.atualizar(s)
        if self.painel is not None:
            self.painel.atualizar(s)
        if self.status_icon is not None:
            self.status_icon.set_label(f"{s['temp_cpu']}°" if s else "")
            self.status_icon.set_tooltip_text(
                f"Avell Fan · {NOME.get(s['perfil'], s['perfil'])} · CPU {s['temp_cpu']}°C · fan "
                f"{max(s['fan1_pct'], s['fan2_pct'])}%" if s else "Avell Fan · serviço parado")
        return True


if __name__ == "__main__":
    GLib.set_application_name("Avell Fan")
    app = App()
    sys.exit(app.run([a for a in sys.argv if a != "--bandeja"]))
