def _arquivo_tema(ref):
    if ref.endswith(".json") or os.sep in ref:
        return os.path.expanduser(ref)
    return _asset("temas", ref + ".json")


def _ler_tema(ref, visto=()):
    caminho = _arquivo_tema(ref)
    if not caminho or not os.path.exists(caminho):
        raise ValueError(f"tema não encontrado: {ref}")
    if caminho in visto:
        raise ValueError(f"herança circular em {ref}")
    with open(caminho) as f:
        t = json.load(f)
    # sem "base": herda do padrão (assim um tema pode ter só as cores que mudam)
    base = t.get("base", None if _arquivo_tema(TEMA_PADRAO) == caminho else TEMA_PADRAO)
    if base:
        b = _ler_tema(base, visto + (caminho,))
        for k in ("cores", "fontes", "raios"):
            b[k] = {**b.get(k, {}), **t.get(k, {})}
        b.update({k: v for k, v in t.items() if k not in ("cores", "fontes", "raios", "base")})
        return b
    return t


def _validar_tema(t):
    cores = t.get("cores", {})
    falta = [c for c in CORES_OBRIGATORIAS if c not in cores]
    if falta:
        raise ValueError("faltam cores: " + ", ".join(falta) + " (use \"base\" para herdar)")
    for k, v in cores.items():
        if not (isinstance(v, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", v)):
            raise ValueError(f"cor {k} inválida: {v!r} (use #rrggbb)")
    for k in ("titulo", "texto", "mono"):
        if not isinstance(t.get("fontes", {}).get(k), str):
            raise ValueError(f"fonte '{k}' ausente")
    for k in ("sm", "md", "lg"):
        v = t.get("raios", {}).get(k)
        if not isinstance(v, (int, float)) or not 0 <= v <= 40:
            raise ValueError(f"raio '{k}' inválido: {v!r} (0 a 40)")


def carregar_tema():
    ref = None
    if "--tema" in sys.argv:
        i = sys.argv.index("--tema")
        ref = sys.argv[i + 1] if i + 1 < len(sys.argv) else None
        del sys.argv[i:i + 2]
    elif os.path.exists(TEMA_USUARIO):
        ref = TEMA_USUARIO
    for tentativa in ([ref] if ref else []) + [TEMA_PADRAO]:
        try:
            t = _ler_tema(tentativa)
            _validar_tema(t)
            return t
        except (ValueError, OSError) as e:
            print(f"avell-fan-gui: tema {tentativa} ignorado: {e}", file=sys.stderr)
    sys.exit("nenhum tema válido encontrado (temas/rotalabs-escuro.json)")


