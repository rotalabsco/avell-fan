def _asset(*parts):
    for base in (HERE, SHARE):
        p = os.path.join(base, *parts)
        if os.path.exists(p):
            return p
    return None


# Fontes do DS (Bricolage Grotesque, Geist, Geist Mono) registradas só para este processo,
# antes do Pango criar o fontmap.
def _register_fonts():
    d = _asset("fonts")
    lib = ctypes.util.find_library("fontconfig")
    if not d or not lib:
        return
    fc = ctypes.CDLL(lib)
    fc.FcConfigAppFontAddFile.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
    for f in glob.glob(os.path.join(d, "*.ttf")):
        fc.FcConfigAppFontAddFile(None, f.encode())


_register_fonts()

